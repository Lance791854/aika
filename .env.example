# LiveKit (required) - from your LiveKit Cloud project settings
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloud stack (required for the default cloud toggles)
DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Optional: Cartesia ink-whisper STT toggle
#CARTESIA_STT_API_KEY=

# Optional: Cloudflare Workers AI stack toggle
#CF_ACCOUNT_ID=
#CF_API_TOKEN=

# Optional: self-hosted stack. Host running Ollama (:11434) + Speaches (:8000).
# Leave unset if you use the SSH tunnel from the README (defaults to localhost).
#AIKA_INFERENCE_HOST=

# Optional: RunPod GPU stack endpoints (defaults assume an SSH tunnel)
#AIKA_GPU_STT_URL=
#AIKA_GPU_LLM_URL=
#AIKA_GPU_TTS_URL=
